# Application settings
APP_NAME="iFood Incident Triage Agent"
APP_ENV=development
LOG_LEVEL=INFO

# LLM Provider Configuration ("gemini", "openai", or "mock")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Financial & Operational Guardrails (BRL / Minutes)
MAX_AUTO_COUPON_BRL=20.0
MAX_AUTO_REFUND_BRL=50.0
HIGH_VALUE_ORDER_THRESHOLD_BRL=100.0
MAX_DELIVERED_MINUTES_FOR_AUTO_REFUND=60

# Persistence (SQLite local path or :memory:)
SQLITE_DB_PATH=:memory:

# Telemetry Cost Estimation (USD per 1M tokens)
INPUT_COST_PER_1M_USD=0.15
OUTPUT_COST_PER_1M_USD=0.60
